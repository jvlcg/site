# URL pública definitiva (usada em canonical, Schema, sitemap, OG).
# Domínio registrado: https://drjosevictor.com
NEXT_PUBLIC_SITE_URL=https://drjosevictor.com

# WhatsApp em formato internacional, SEM "+", SEM espaços.
# Particular (Dr. José Victor — CTA principal do site):
NEXT_PUBLIC_WHATSAPP=5562999758034
# Planos de saúde (secretária — opção secundária/discreta):
NEXT_PUBLIC_WHATSAPP_PLANOS=5562999961365

# --- Assistente virtual com IA (opcional) ---
# Sem esta chave o chat continua funcionando em modo "reserva" (respostas por
# palavra-chave). Com ela, as respostas passam a ser geradas por IA, sempre
# limitadas ao conteúdo do site e às regras de segurança (lib/knowledge.ts).
# Obtenha em https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modelo (opcional). Padrão: claude-haiku-4-5-20251001 (rápido e econômico).
ANTHROPIC_MODEL=

# --- Avaliações do Google AO VIVO (opcional) ---
# Chave do Google Cloud com "Places API (New)" ativada e faturamento habilitado.
# Com ela, o site puxa nota + comentários reais do Google automaticamente.
GOOGLE_PLACES_API_KEY=
# (Opcional) ID do local. Se vazio, é resolvido pelo nome/endereço do consultório.
GOOGLE_PLACE_ID=

# --- Segurança ---
# Senha do diagnóstico da IA: GET /api/chat?token=...
# Sem esta variável o diagnóstico responde 404 (fica desligado).
DIAG_TOKEN=
# Domínios extras autorizados a chamar a API, separados por vírgula.
# Só é necessário se o site atender por mais de um domínio (ex.: o "www").
ALLOWED_ORIGINS=

# --- Google Search Console (opcional) ---
# Código de verificação pelo método "tag HTML" — dispensa mexer em DNS.
# Só use depois que drjosevictor.com estiver apontado para a Vercel.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Sincronização com a Soro (opcional) ---
# Token do embed usado por scripts/sync-soro.mjs. Se vazio, usa o token atual
# embutido no script. Só precisa definir se o embed for trocado.
SORO_EMBED_TOKEN=

# --- Avisos de conteúdo novo (notificações do navegador) ---
# Gere o par de chaves com: npm run vapid
# A pública vai para a Vercel (aparece no navegador, pode ser pública).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# A privada NUNCA vai para a Vercel nem para o código — só para os
# Secrets do GitHub, onde o robô de envio a usa.
# VAPID_PRIVATE_KEY=  (GitHub → Settings → Secrets → Actions)
# VAPID_SUBJECT=https://drjosevictor.com

# Onde ficam as inscrições. É o Redis do marketplace da Vercel (Upstash).
# Sem estas duas, o site simplesmente não oferece a opção de aviso.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cadastro de pacientes ---
# Chave de criptografia das fichas (AES-256-GCM). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ATENÇÃO: trocar esta chave torna ILEGÍVEIS todos os cadastros já gravados.
CADASTRO_CHAVE=
# Senha da área restrita (/area-restrita). Mínimo de 10 caracteres.
ADMIN_SENHA=
# (Opcional) Segredo próprio para assinar o cookie de sessão.
# Sem ele, a assinatura é derivada da senha — e trocar a senha derruba as sessões.
ADMIN_SEGREDO=
